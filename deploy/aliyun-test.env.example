# 阿里云独立测试环境。复制后填写，不要提交真实值。
# 当前测试入口是 HTTP。不要配置证书，不要把 HTTP 跳到 HTTPS。
# 以后正式环境改为 HTTPS 时，只把 WORKBENCH_SECURE_COOKIE 改为 true。

PORT=8788
WORKBENCH_SECURE_COOKIE=false
WORKBENCH_DB_URL=jdbc:mysql://127.0.0.1:3306/soongo_aftersales_trial?serverTimezone=Asia/Shanghai&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
WORKBENCH_DB_USER=
WORKBENCH_DB_PASSWORD=
WORKBENCH_LOGIN_USER=
WORKBENCH_LOGIN_PASSWORD_HASH=

# 仅在测试机跑 scripts/smoke.py 时需要，值为测试账号的明文口令
WORKBENCH_TEST_URL=http://127.0.0.1:8788
WORKBENCH_TEST_USER=
WORKBENCH_TEST_PASSWORD=
